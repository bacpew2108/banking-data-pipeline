# ============================================================================
# Mẫu cấu hình. Sao chép thành .env rồi thay mọi giá trị <...> bằng giá trị thật.
# KHÔNG commit file .env. File này chỉ chứa giá trị giữ chỗ.
#
# Sinh nhanh một chuỗi ngẫu nhiên:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Mật khẩu chỉ nên dùng chữ, số, '-' và '_' (an toàn trong URI kết nối và docker-compose).
# ============================================================================

# SQL Server (mật khẩu cần có chữ hoa, chữ thường và số, tối thiểu 8 ký tự)
MSSQL_SA_PASSWORD=<mat-khau-sql-server>
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=banking_db
DB_SCHEMA=dbo
DB_USER=sa
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_CERT=yes

# Ingestion / Replay
SOURCE_FILE_PATH=ingestion/source_data/transactions_full.sql
CHECKPOINT_FILE_PATH=ingestion/checkpoint_state.json
REJECTED_FILE_PATH=ingestion/dlq/rejected_transactions.jsonl
BATCH_SIZE=30
BATCH_INTERVAL=5.0
MAX_RETRIES=5
RETRY_DELAY=5.0

# PostgreSQL (Data Warehouse)
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=<mat-khau-dwh>
POSTGRES_DB=banking

# Role chỉ-đọc cho Superset trên Data Warehouse (chỉ SELECT schema gold)
SUPERSET_DWH_USER=superset_reader
SUPERSET_DWH_PASSWORD=<mat-khau-superset-reader>

# DATA LAKE (MINIO)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=<mat-khau-minio>
# Mã hóa at-rest SSE-S3: <tên-khóa>:<base64 của 32 byte ngẫu nhiên>
# Sinh: python3 -c "import os,base64; print('banking-sse-key:' + base64.b64encode(os.urandom(32)).decode())"
# ĐỔI KHÓA = không đọc được dữ liệu đã mã hóa trước đó.
MINIO_KMS_SECRET_KEY=<ten-khoa>:<base64-32-bytes>

# Bảo mật dữ liệu thẻ (PII): salt bí mật cho hash card_number ở tầng Silver
PII_HASH_SALT=<chuoi-ngau-nhien>

# Database backend cho Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=<mat-khau-airflow-db>
AIRFLOW_DB_NAME=airflow

# Tài khoản đăng nhập Web UI của Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=<mat-khau-airflow-admin>

# Khóa bảo mật Airflow
# Fernet key sinh bằng: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=<fernet-key>
AIRFLOW_SECRET_KEY=<chuoi-ngau-nhien>
AIRFLOW_JWT_SECRET=<chuoi-ngau-nhien>

# Database backend cho Superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=<mat-khau-superset-db>
SUPERSET_DB_NAME=superset
SUPERSET_ADMIN_PASSWORD=<mat-khau-superset-admin>
SUPERSET_SECRET_KEY=<chuoi-ngau-nhien-dai>

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<mat-khau-grafana>

# Prometheus Pushgateway (metrics Spark streaming, GE, Airflow DAG, ingestion)
PUSHGATEWAY_URL=http://pushgateway:9091

# Số partition cho mỗi shuffle của Spark Silver (nhỏ vì micro-batch nhỏ)
SPARK_SHUFFLE_PARTITIONS=4
